      "targets": [
        {
          "azureLogAnalytics": { "query": "let Baseline = materialize(print Items = split(${requiredKBs:singlequote}, ',')\n| mv-expand RequiredKB = Items to typeof(string)\n| extend RequiredKB = toupper(replace_string(RequiredKB, ' ', ''))\n| where RequiredKB matches regex @'^KB[0-9]{6,8}$'\n| distinct RequiredKB);\nlet InstalledPairs = materialize(ConfigurationData\n| where ConfigDataType =~ 'Software' and SoftwareType =~ 'Patch'\n| where TimeGenerated >= ago(${inventoryFreshness:raw})\n| extend KB = toupper(extract(@'KB[0-9]{6,8}', 0, SoftwareName))\n| where isnotempty(KB)\n| extend NormalizedComputer = tolower(iff(Computer has '.', substring(Computer, 0, indexof(Computer, '.')), Computer))\n| distinct PairKey = strcat(NormalizedComputer, '|', KB));\nlet InScopeMachines = materialize(ConfigurationData\n| where ConfigDataType =~ 'Software'\n| where TimeGenerated >= ago(${inventoryFreshness:raw})\n| where isempty(${computerSearch:singlequote}) or Computer contains ${computerSearch:singlequote}\n| extend NormalizedComputer = tolower(iff(Computer has '.', substring(Computer, 0, indexof(Computer, '.')), Computer))\n| summarize LastInventory = max(TimeGenerated) by NormalizedComputer);\nlet Compliance = materialize(InScopeMachines\n| extend JoinKey = 1\n| join kind=inner (Baseline | extend JoinKey = 1) on JoinKey\n| extend PairKey = strcat(NormalizedComputer, '|', RequiredKB)\n| extend IsInstalled = PairKey in (InstalledPairs)\n| summarize MissingUpdates = countif(not(IsInstalled)) by NormalizedComputer\n| extend ComplianceState = iff(MissingUpdates == 0, 'Compliant', 'Noncompliant'));\nlet CompliantCount = toscalar(Compliance | summarize c = countif(ComplianceState == 'Compliant'));\nlet TotalCount = toscalar(Compliance | summarize c = count());\nprint ['Baseline updates'] = toscalar(Baseline | summarize c = dcount(RequiredKB)), ['Compliant computers'] = CompliantCount, ['Noncompliant computers'] = toscalar(Compliance | summarize c = countif(ComplianceState == 'Noncompliant')), ['Compliance percent'] = iff(TotalCount == 0, 0.0, round(100.0 * CompliantCount / TotalCount, 1))", "resultFormat": "table", "resources": [ "$workspaceResourceId" ] },
