      "targets": [
        {
          "azureLogAnalytics": {
            "query": "ConfigurationData\n| where ConfigDataType =~ \"Software\"\n| extend NormalizedResourceId = tolower(_ResourceId)\n| parse NormalizedResourceId with \"/subscriptions/\" AzureSubscriptionId \"/resourcegroups/\" AzureResourceGroup \"/providers/\" AzureResourceProvider \"/\" AzureResourceKind \"/\" *\n| extend AzureResourceType = case(AzureResourceProvider =~ \"microsoft.compute\" and AzureResourceKind =~ \"virtualmachines\", \"Azure VM\", AzureResourceProvider =~ \"microsoft.hybridcompute\" and AzureResourceKind =~ \"machines\", \"Arc server\", \"Other\")\n| summarize LastInventory = max(TimeGenerated), ResourceId = take_any(_ResourceId), SubscriptionId = take_any(AzureSubscriptionId), ResourceGroup = take_any(AzureResourceGroup), ResourceType = take_any(AzureResourceType) by Computer\n| where isempty(${computerSearch:singlequote}) or Computer contains ${computerSearch:singlequote}\n| extend InventoryAgeDays = datetime_diff(\"day\", now(), LastInventory)\n| extend InventoryState = iff(LastInventory >= ago(${inventoryFreshness:raw}), \"Current\", \"Stale\")\n| project Computer, InventoryState, LastInventory, InventoryAgeDays, SubscriptionId, ResourceGroup, ResourceType, ResourceId\n| sort by InventoryState asc, LastInventory desc",
            "resultFormat": "table",
            "resources": [ "$workspaceResourceId" ]
          },
          "datasource": {
            "type": "grafana-azure-monitor-datasource",
            "uid": "__AZURE_MONITOR_DATASOURCE_UID__"
